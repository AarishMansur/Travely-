# Travely environment variables - copy this file to .env and fill in your values
# SerpApi key from https://serpapi.com/manage-api-key (never expose this to the browser)
SERPAPI_KEY=your_serpapi_key_here
# Local MongoDB, e.g. mongodb://127.0.0.1:27017/travely
MONGODB_URI=mongodb://127.0.0.1:27017/travely
PORT=3000
